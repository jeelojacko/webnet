    "preanalysis-traverse-only": "#Traverse Only\n# 2025 Suvery Design Pre-Analysis\n# Edited by: Kallum Fletcher, Owen Crawford\n\n\n########################\n#\tPoint\tEasting(m)\tNorthing(m)\theight (m)\n##### GPS Points\nC\tGPS1\t682579.733\t5090745.219\t65 0.005 0.005 0.01\nC\tGPS2\t683005.038\t5090804.624\t39 0.005 0.005 0.01\nC\tGPS3\t682770.787\t5091288.078\t17 0.005 0.005 0.01\nC\tGPS4\t682590.839\t5090466.658\t83 0.005 0.005 !\nC\tGPS5\t683186.559\t5090575.718\t46 0.005 0.005 0.01\nC\tGPS6\t682736.72\t5091053.517\t35 0.005 0.005 0.01\nC\tFRDN\t681416.428\t5089320.311\t117 ! ! !\nB GPS2-GPS5 N60-29-49.36W !\n\n##### Intermediate Points\nC\t100\t\t682643.05\t5090565.131\t78\nC\t101\t\t682660.993\t5090500.146\t80\nC\t102\t\t682675.737\t5090479.215\t79\nC\t103\t\t682742.462\t5090462.755\t77\nC\t104\t\t682880.71\t5090569.48\t67\nC\t105\t\t682985.308\t5090664.84\t54\nC\t106\t\t683030.421\t5090543.498\t60\nC\t107\t\t683106.771\t5090490.151\t58\nC\t108\t\t683142.617\t5090504.128\t54\nC\t109\t\t682979.351\t5090926.628\t30\nC\t110\t\t682920.129\t5090886.545\t39\nC\t111\t\t682823.423\t5090809.883\t51\nC\t112\t\t682816.253\t5090871.842\t47\nC\t113\t\t682781.514\t5090883.411\t49\nC\t114\t\t682920.52\t5091055.211\t23\nC\t115\t\t682825.264\t5090977.285\t38\nC\t116\t\t682878.427\t5091225.089\t13\nC\t117\t\t682718.089\t5091277.136\t21\nC\t118\t\t682685.863\t5091218.792\t26\nC\t119\t\t682638.17\t5091094.422\t34\nC\t120\t\t682543.107\t5090942.726\t50\nC\t121\t\t682594.925\t5090796.907\t61\nC\t122\t\t682680.342\t5090826.936\t54\nC\t123\t\t682742.847\t5090748.17\t58\nC\t124\t\t682686.515\t5090632.827\t71\nC\t125\t\t682522.801\t5090682.042\t73\nC\t126\t\t682565.901\t5090563.474\t80\nC\t127\t\t682778.057\t5091004.059\t38\nC   128     682916.792  5090448.563 75\nC   129     682971.313  5090426.702 72\n\n##### Control Points\nC\tFM1\t\t682628.95\t5090893.569\t51\nC\tOOP\t\t682579.733\t5090745.219\t65\nC\tAPOG\t682590.839\t5090466.658\t83\nC\tPEAT\t682655.928\t5090526.962\t79\nC\tPITA\t683074.918\t5090482.434\t61\nC\tPOT\t\t683172.088\t5090520.232\t50\nC\tGATE\t682960.388\t5091114.327\t15\nC\tBROD\t682770.787\t5091288.078\t17\nC\tTIMS\t682852.981\t5090655.002\t60\n\n#### Extra\nC\tMeridian\t682864.078\t5090804.797\t0\nC\tOLDA\t682826.727\t5091000.544\t0\n\n###################################################\n\n#### Observations\n\n.INSTRUMENT SX12\nDB 128\nDM 103\nDM 104\nDM TIMS\nDM 129\nDE\n#Set2\nDB 128\nDM 103\nDM 104\nDM TIMS\nDM 129\nDE\n\nDB 129\nDM 128\nDM PITA\nDE\n#Set2\nDB 129\nDM 128\nDM PITA\nDE\n\nDB 100\nDM 126\nDM GPS4\nDM 124\nDM PEAT\nDE\n#Set2\nDB 100\nDM 126\nDM GPS4\nDM 124\nDM PEAT\nDE\n\nDB 101 \nDM PEAT\nDM 102\nDE\n#Set2\nDB 101 \nDM PEAT\nDM 102\nDE\n\nDB 102\nDM 101\nDM GPS4\nDM 103\nDE\n#Set2\nDB 102\nDM 101\nDM GPS4\nDM 103\nDE\n\n\nDB 103\nDM 102\nDM 104\n#DM 128\nDE\n#Set2 \nDB 103\nDM 102\nDM 104\n#DM 128\nDE\n\nDB 104\nDM 103\nDM 124\nDM TIMS\n#DM 128\nDM 105\nDE\n#Set2\nDB 104\nDM 103\nDM 124\nDM TIMS\n#DM 128\nDM 105\nDE\n\nDB 105\nDM 104\nDM 111\nDM GPS2\nDM 106 \nDE\n#Set2\nDB 105\nDM 104\nDM 111\nDM GPS2\nDM 106 \nDE\n\nDB 106\nDM 105\nDM 108\nDM PITA\nDM POT\nDE\n#Set2\nDB 106\nDM 105\nDM 108\nDM PITA\nDM POT\nDE\n\n\nDB 107\nDM PITA\nDM 108\nDE\n#Set2\nDB 107\nDM PITA\nDM 108\nDE\n\n\nDB 108\nDM 107\nDM 106\nDM POT \nDE\n#Set 2\nDB 108\nDM 107\nDM 106\nDM POT \nDE\n\n\nDB 109\nDM GPS2\nDM 110\nDM 114\nDE\n#Set2\nDB 109\nDM GPS2\nDM 110\nDM 114\nDE\n\nDB 110\nDM GPS2\nDM 115\nDM 109\nDM 127\nDM OLDA\nDE\n#Set2\nDB 110\nDM GPS2\nDM 115\nDM 109\nDM 127\nDM OLDA\nDE\n\n\nDB 111\nDM 105\nDM 112\nDM Meridian\nDE\n#Set2\nDB 111\nDM 105\nDM 112\nDM Meridian\nDE\n\n\nDB 112\nDM Meridian\nDM 111\nDM 113\nDM FM1\nDE\n#Set2\nDB 112\nDM Meridian\nDM 111\nDM 113\nDM FM1\nDE\n\n\nDB 113\nDM 112\nDM 115\nDM 122\nDM OLDA\nDE\n#Set2\nDB 113\nDM 112\nDM 115\nDM 122\nDM OLDA\nDE\n\nDB 114\nDM 109\nDM GATE\nDE\n#Set2\nDB 114\nDM 109\nDM GATE\nDE\n\nDB 115\nDM 110\nDM 113\nDM 127\nDE\n#Set2\nDB 115\nDM 110\nDM 113\nDM 127\nD